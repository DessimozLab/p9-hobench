  "source": "MED",
  "title": "Beyond the Whole-Genome Duplication: Phylogenetic Evidence for an Ancient Interspecies Hybridization in the Baker's Yeast Lineage",
  "authors": [
    "Marcet-Houben M",
    "Gabaldón T"
  ],
  "year": 2015,
  "journal": "PLoS biology",
